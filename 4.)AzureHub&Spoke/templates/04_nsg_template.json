{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "eastus"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-09-01",
      "name": "nsg-spoke-workloads",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "allow-management-from-hub",
            "properties": {
              "description": "Permit administrative RDP/SSH strictly from Hub Shared Services / Jumpbox",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRanges": [
                "3389",
                "22"
              ],
              "sourceAddressPrefix": "10.100.10.0/24",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 1000,
              "direction": "Inbound"
            }
          }
        ]
      }
    }
  ]
}
